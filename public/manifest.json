{
  "manifest_version": 3,
  "name": "Flockt - Group Your Tabs with AI",
  "version": "1.0.0",
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "host_permissions": ["https://*/*"],
  "permissions": ["tabGroups", "tabs"]
}
